# Copy to .env (never committed). Read at build time by Astro.

# Public URL, no trailing slash (canonical URLs, sitemap, Open Graph).
SITE_URL=https://ramirofrank.pages.dev

# Contact form: Web3Forms access key (https://web3forms.com). Empty = form hidden.
PUBLIC_WEB3FORMS_KEY=

# Optional: Umami Cloud website ID (privacy-friendly analytics, no cookies). Empty = disabled.
PUBLIC_UMAMI_WEBSITE_ID=
