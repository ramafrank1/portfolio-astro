---
import { anchors, routes, t } from '@/i18n/ui';
import { contact, person, whatsappLink } from '@/data/site';
import type { Lang } from '@/data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const i = t(lang);
const a = anchors[lang];
const home = routes.home[lang];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="tiles">
    <div class="tile tile--statement">
      <p class="tile__big">{i.footer.statement}</p>
      <p class="small soft">© <span data-year>{year}</span> {i.footer.rights}</p>
    </div>
    <nav class="tile tile--nav" aria-label={i.nav.primary}>
      <ul role="list">
        <li><a href={`${home}#${a.work}`}>{i.nav.work}</a></li>
        <li><a href={`${home}#${a.services}`}>{i.nav.services}</a></li>
        <li><a href={`${home}#${a.process}`}>{i.nav.process}</a></li>
        <li><a href={`${home}#${a.about}`}>{i.nav.about}</a></li>
        <li><a href={whatsappLink(i.contact.waDefault)} target="_blank" rel="noopener" data-track="contact_whatsapp" data-track-where="footer">WhatsApp</a></li>
        <li><a href={contact.linkedin} target="_blank" rel="noopener me" data-track="social_linkedin">LinkedIn</a></li>
        <li><a href={contact.instagram} target="_blank" rel="noopener me" data-track="social_instagram">Instagram</a></li>
      </ul>
    </nav>
    <div class="tile tile--time">
      <p class="small soft">{i.footer.time}</p>
      <p class="tile__big"><time data-clock data-tz={person.timeZone} data-locale={i.htmlLang}>GMT−3</time></p>
    </div>
    <div class="tile tile--mail">
      <p class="small soft">{i.footer.write}</p>
      <a class="tile__mail" href={`mailto:${contact.email}`} data-track="contact_email" data-track-where="footer">{contact.email}</a>
    </div>
    <div class="tile tile--word carbon" aria-hidden="true"><span>Ramiro Frank</span></div>
    <a class="tile tile--go" href={`${home}#${a.contact}`} data-track="cta_quote" data-track-where="footer">
      <span class="tile__big">{i.footer.invite}</span>
      <svg viewBox="0 0 48 48" width="56" height="56" aria-hidden="true"><path d="M10 38 38 10M16 10h22v22" fill="none" stroke="currentColor" stroke-width="4" /></svg>
    </a>
  </div>
</footer>

<style>
  .footer { padding: 8px; }
  .tiles { display: grid; gap: 8px; grid-template-columns: repeat(2, 1fr); }
  .tile { display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; min-height: 11rem; padding: 1.25rem; background: var(--surface-2); }
  .tile__big { font-size: var(--t-lead); font-weight: 300; line-height: 1.25; letter-spacing: -0.01em; }
  .tile a { text-decoration: none; }
  .tile a:hover { text-decoration: underline; }
  .tile--nav ul { display: grid; gap: 0.25rem; }
  .tile--nav a { display: inline-flex; min-height: 1.75rem; align-items: center; }
  .tile__mail { font-size: var(--t-lead); font-weight: 300; overflow-wrap: anywhere; }
  .tile--word { justify-content: center; align-items: center; min-height: 10rem; overflow: hidden; background: var(--carbon); color: var(--on-carbon); }
  .tile--word span { font-size: 11vw; font-weight: 300; letter-spacing: -0.06em; line-height: 0.9; white-space: nowrap; }
  .tile--go { background: var(--accent); color: var(--on-accent); text-decoration: none !important; transition: background-color 0.25s; }
  .tile--go:hover { background: #ffbb1a; }
  .tile--go svg { align-self: flex-end; transition: transform 0.35s var(--ease-out); }
  .tile--go:hover svg { transform: translate(4px, -4px); }

  /* Phone: DOM order is the visual order (tab order matches). */
  .tile--statement, .tile--mail, .tile--word, .tile--go { grid-column: 1 / -1; }

  @media (min-width: 64rem) {
    .tiles { grid-template-columns: repeat(12, 1fr); }
    .tile { min-height: 13.75rem; }
    .tile--statement { grid-column: 1 / 5; }
    .tile--nav { grid-column: 5 / 8; }
    .tile--time { grid-column: 8 / 10; }
    .tile--mail { grid-column: 10 / 13; }
    .tile--word { grid-column: 1 / 9; min-height: 20rem; }
    .tile--word span { font-size: 9vw; }
    .tile--go { grid-column: 9 / 13; min-height: 20rem; }
    .tile--nav ul { grid-template-columns: 1fr 1fr; column-gap: 1rem; }
  }
</style>
