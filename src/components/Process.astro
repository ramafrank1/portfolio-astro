---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { anchors, t } from '@/i18n/ui';
import { processSteps } from '@/data/content';
import type { Lang } from '@/data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const i = t(lang);
---
<section class="section process" id={anchors[lang].process} aria-labelledby="process-title">
  <div class="wrap process__top">
    <h2 id="process-title" class="heading" data-reveal>{i.process.title}</h2>
    <div class="process__btns" data-moments-btns hidden>
      <button type="button" class="sq" data-moments-prev aria-label={i.process.back}><Icon name="ArrowLeft" /></button>
      <button type="button" class="sq" data-moments-next aria-label={i.process.forward}><Icon name="ArrowRight" /></button>
    </div>
  </div>
  <div class="wrap"><div class="progress" aria-hidden="true"><span data-moments-bar></span></div></div>

  <ol class="moments" data-moments data-reveal tabindex="0" aria-labelledby="process-title">
    {processSteps.map((s) => (
      <li class="moment">
        <h3>{s.title[lang]}</h3>
        <p>{s.text[lang]}</p>
        <figure>
          <Picture src={s.image} alt={s.caption[lang]} formats={['avif']} fallbackFormat="webp" widths={[300, 560]} sizes="(min-width: 48rem) 280px, 72vw" loading="lazy" decoding="async" />
          <figcaption class="small soft">{s.caption[lang]}</figcaption>
        </figure>
      </li>
    ))}
  </ol>
</section>

<style>
  .process { background: var(--surface-2); }
  .process__top { display: flex; justify-content: space-between; align-items: end; gap: 1rem; }
  .process__btns { display: flex; gap: 0.5rem; }
  .progress { position: relative; height: 6px; margin-top: 2rem; background: var(--bg); overflow: hidden; }
  .progress span { position: absolute; inset: 0; background: var(--ink); transform-origin: left; transform: scaleX(var(--p, 0.25)); transition: transform 0.2s linear; }

  .moments {
    display: flex; gap: 32px; margin-top: 3rem;
    list-style: none; padding: 0 var(--margin);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--margin);
    scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .moments::-webkit-scrollbar { display: none; }
  .moment { flex: none; width: 280px; scroll-snap-align: start; display: flex; flex-direction: column; }
  .moment h3 { font-size: var(--t-body); font-weight: 500; letter-spacing: -0.01em; line-height: 1.3; }
  .moment > p { margin-top: 0.5rem; }
  .moment figure { margin-top: var(--space, 96px); }
  .moment:nth-child(2) { --space: 140px; } .moment:nth-child(3) { --space: 80px; } .moment:nth-child(4) { --space: 124px; }
  .moment:nth-child(5) { --space: 88px; } .moment:nth-child(6) { --space: 132px; }
  .moment :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; background: var(--bg); }
  .moment figcaption { margin-top: 0.6rem; }
  @media (max-width: 47.99rem) {
    .moments { gap: 16px; }
    .moment { width: 72vw; }
    .moment figure { margin-top: calc(var(--space, 96px) * 0.4); }
  }
</style>
