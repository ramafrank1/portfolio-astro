---
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from './Icon.astro';
import { anchors, routes, t } from '@/i18n/ui';
import { projects, statusLabel, type Lang, type Project } from '@/data/projects';
import { whatsappLink } from '@/data/site';

interface Props { lang: Lang; project: Project }
const { lang, project: p } = Astro.props;
const i = t(lang);
const c = i.case;
const site = Astro.site!;
const idx = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(idx + 1) % projects.length];
const home = routes.home[lang];
const alternates = { es: routes.project.es(p.slug), en: routes.project.en(p.slug) };
const desktopShots = p.gallery.filter((g) => g.device === 'desktop');
const mobileShots = [p.cover.mobile, ...p.gallery.filter((g) => g.device === 'mobile')];

const title = `${p.name} — ${p.kind[lang]} | Ramiro Frank`;
const description = `${p.summary[lang]} ${p.statusNote[lang]}.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: p.name,
    description: p.summary[lang],
    url: new URL(alternates[lang], site).href,
    inLanguage: i.htmlLang,
    creator: { '@id': new URL('/#person', site).href },
    about: p.sector[lang],
    keywords: p.stack.join(', '),
    dateCreated: String(p.year),
    ...(p.online ? { sameAs: p.url } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ramiro Frank', item: new URL(home, site).href },
      { '@type': 'ListItem', position: 2, name: i.nav.work, item: new URL(`${home}#${anchors[lang].work}`, site).href },
      { '@type': 'ListItem', position: 3, name: p.name, item: new URL(alternates[lang], site).href },
    ],
  },
];
const blocks = [
  { label: c.context, text: p.context[lang] },
  { label: c.problem, text: p.problem[lang] },
  { label: c.solution, text: p.solution[lang] },
];
---
<Base lang={lang} title={title} description={description} alternates={alternates} jsonLd={jsonLd} ogType="article" ogImage={`/og/${p.slug}-${lang}.png`}>
  <article class="case">
    <header class="case__head carbon">
      <div class="wrap">
        <a class="back small" data-reveal href={`${home}#${anchors[lang].work}`}><Icon name="ArrowLeft" size={16} />{c.back}</a>
        <h1 class="case__title" data-reveal>{p.name}</h1>
        <p class="lead case__kind" data-reveal>{p.kind[lang]}</p>
        <ul role="list" class="case__keys">
          <li data-reveal><span class={`status status--${p.status}`}>{statusLabel[p.status][lang]}</span></li>
          <li data-reveal>{p.client[lang]}</li>
          <li data-reveal>{p.year}</li>
        </ul>
      </div>
      <div class="wrap case__lead" data-vt={`shot-${p.slug}`} data-reveal>
        <Picture src={p.cover.desktop.src} alt={p.cover.desktop.alt[lang]} formats={['avif']} fallbackFormat="webp" widths={[720, 1080, 1440, 2000]} sizes="(min-width: 90rem) 86rem, 96vw" loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </header>

    <div class="wrap case__facts">
      <table class="facts">
        <caption class="sr-only">{c.facts}</caption>
        <tbody>
          <tr data-reveal><th scope="row">{p.sold ? c.client : c.forWhom}</th><td>{p.client[lang]}</td></tr>
          <tr data-reveal><th scope="row">{c.sector}</th><td>{p.sector[lang]}</td></tr>
          <tr data-reveal><th scope="row">{c.status}</th><td><span class={`status status--${p.status}`}>{statusLabel[p.status][lang]}</span> <span class="soft">· {p.statusNote[lang].split(' · ').slice(1).join(' · ')}</span></td></tr>
          <tr data-reveal><th scope="row">{c.year}</th><td>{p.year}</td></tr>
          <tr data-reveal><th scope="row">{c.stack}</th><td>{p.stack.join(', ')}</td></tr>
          <tr data-reveal><th scope="row">{c.link}</th><td>{p.online
            ? <a class="link" href={p.url} target="_blank" rel="noopener" data-track="project_visit" data-project={p.slug} data-track-where="case_facts">{p.urlLabel}<Icon name="ArrowUpRight" /></a>
            : <span class="soft">{i.work.offline}</span>}</td></tr>
        </tbody>
      </table>
      {p.note && <p class="note" data-reveal>{p.note[lang]}</p>}
    </div>

    <div class="wrap case__blocks">
      {blocks.map((b) => (
        <section class="block" data-reveal>
          <h2 class="block__label">{b.label}</h2>
          <p class="lead">{b.text}</p>
        </section>
      ))}
    </div>

    <section class="wrap features" aria-labelledby="features-title">
      <h2 id="features-title" class="heading" data-reveal>{c.features}</h2>
      <div class="features__cols">
        {p.features.map((g) => (
          <div class="feature" data-reveal>
            <h3>{g.title[lang]}</h3>
            <ul>{g.items.map((it) => <li>{it[lang]}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="gallery" aria-labelledby="gallery-title">
      <h2 id="gallery-title" class="wrap heading" data-reveal>{c.gallery}</h2>
      <div class="sheet">
        {desktopShots.map((g) => (
          <figure class="sheet__frame" data-reveal>
            <Picture src={g.src} alt={g.alt[lang]} formats={['avif']} fallbackFormat="webp" widths={[640, 960, 1440]} sizes="(min-width: 64rem) 48vw, 96vw" loading="lazy" decoding="async" />
            <figcaption class="small soft">{g.alt[lang]}</figcaption>
          </figure>
        ))}
        {mobileShots.map((g) => (
          <figure class="sheet__frame sheet__frame--phone" data-reveal>
            <Picture src={g.src} alt={g.alt[lang]} formats={['avif']} fallbackFormat="webp" widths={[300, 600]} sizes="(min-width: 64rem) 22vw, 46vw" loading="lazy" decoding="async" />
            <figcaption class="small soft">{g.alt[lang]}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <div class="wrap case__lists">
      <section data-reveal>
        <h2 class="heading">{c.decisions}</h2>
        <ol class="decisions">{p.decisions.map((d) => <li>{d[lang]}</li>)}</ol>
      </section>
      {p.notIncluded.length > 0 && (
        <section data-reveal>
          <h2 class="heading">{c.notIncluded}</h2>
          <ul class="pending">{p.notIncluded.map((d) => <li>{d[lang]}</li>)}</ul>
        </section>
      )}
    </div>

    <section class="cta carbon" aria-labelledby="cta-title">
      <div class="wrap cta__inner">
        <h2 id="cta-title" class="heading" data-reveal>{c.ctaTitle}</h2>
        <p class="cta__text" data-reveal>{c.ctaText}</p>
        <div class="cta__actions" data-reveal>
          <a class="btn btn--accent" href={whatsappLink(c.waMessage(p.name))} target="_blank" rel="noopener" data-track="contact_whatsapp" data-track-where="case_cta" data-project={p.slug}>WhatsApp<Icon name="ArrowUpRight" /></a>
          <a class="link" href={`${home}#${anchors[lang].contact}`} data-track="cta_quote" data-track-where="case_cta">{i.nav.cta}<Icon name="ArrowRight" /></a>
        </div>
      </div>
    </section>

    <nav class="wrap next" aria-label={c.next}>
      <a href={routes.project[lang](next.slug)} class="next__link" data-track="project_open" data-track-where="case_next" data-project={next.slug}>
        <span class="soft">{c.next}</span>
        <span class="next__name">{next.name}<Icon name="ArrowRight" size={44} /></span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .case__head { padding: 2.5rem 0 0; }
  .back { display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none; color: var(--on-carbon-muted); margin-bottom: 3rem; }
  .back:hover { color: var(--on-carbon); }
  .case__title { font-size: var(--t-display); line-height: 0.92; letter-spacing: -0.05em; }
  .case__kind { margin-top: 1.25rem; max-width: 30ch; color: var(--on-carbon-muted); }
  .case__keys { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin-top: 2rem; color: var(--on-carbon); }
  .case__lead { margin-top: 3.5rem; padding-bottom: 0; }
  .case__lead > :global(picture) { display: block; overflow: hidden; }
  .case__lead :global(img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; }
  /* The lead capture settles into place: a slow scale, transform only. */
  :global(.motion-ok) .case__lead :global(img) { animation: settle 1.8s var(--ease-out) both; }
  @keyframes settle { from { transform: scale(1.06); } to { transform: none; } }

  .case__facts { display: grid; gap: 2rem; margin-top: 4rem; }
  @media (min-width: 64rem) { .case__facts { grid-template-columns: 7fr 5fr; column-gap: 4rem; align-items: start; } }
  /* A real table: the one place where lines belong. */
  .facts { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .facts td { overflow-wrap: anywhere; }
  .facts th, .facts td { padding: 0.8rem 0; border-bottom: 1px solid #d9dcdb; text-align: left; vertical-align: top; }
  .facts th { width: 9rem; padding-right: 1.5rem; font-weight: 400; color: var(--muted); }
  @media (max-width: 30rem) { .facts th { width: 6.5rem; padding-right: 0.75rem; } .facts .link { display: inline; } .facts .status { white-space: normal; } }
  .note { padding: 1.25rem; background: var(--surface-2); }

  .case__blocks { display: grid; gap: 4rem; margin-top: var(--section); }
  .block { display: grid; gap: 1rem; }
  @media (min-width: 64rem) { .block { grid-template-columns: repeat(12, 1fr); column-gap: 1.25rem; } .block__label { grid-column: 1 / 4; } .block .lead { grid-column: 4 / 12; } }
  .block__label { font-size: var(--t-body); font-weight: 500; letter-spacing: 0; line-height: 1.6; }
  .block .lead { max-width: 40ch; }

  .features { margin-top: var(--section); }
  .features__cols { display: grid; gap: 2.5rem; margin-top: 3rem; }
  @media (min-width: 48rem) { .features__cols { grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); column-gap: 2rem; } }
  .feature h3 { font-size: var(--t-lead); font-weight: 300; letter-spacing: -0.015em; margin-bottom: 1rem; }
  .feature ul { display: grid; gap: 0.6rem; padding-left: 1.1rem; }
  .feature li::marker { color: var(--muted); }

  .gallery { margin-top: var(--section); }
  .sheet { display: grid; gap: 8px; margin-top: 3rem; padding-inline: var(--margin); grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 64rem) { .sheet { grid-template-columns: repeat(4, 1fr); } .sheet__frame:not(.sheet__frame--phone) { grid-column: span 2; } }
  .sheet__frame:not(.sheet__frame--phone) { grid-column: 1 / -1; }
  @media (min-width: 64rem) { .sheet__frame:not(.sheet__frame--phone) { grid-column: span 2; } }
  .sheet__frame :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; background: var(--surface-2); }
  .sheet__frame--phone :global(img) { aspect-ratio: 9 / 16; }
  .sheet__frame figcaption { margin-top: 0.5rem; padding-right: 1rem; }

  .case__lists { display: grid; gap: 4rem; margin-top: var(--section); }
  @media (min-width: 64rem) { .case__lists { grid-template-columns: 7fr 5fr; column-gap: 4rem; } }
  .decisions, .pending { display: grid; gap: 1rem; margin-top: 2rem; padding-left: 1.4rem; max-width: 60ch; }
  .decisions li::marker { color: var(--muted); }
  .pending li { color: var(--muted); }

  .cta { margin-top: var(--section); padding-block: clamp(5rem, 3rem + 6vw, 10rem); }
  .cta__text { margin-top: 1.25rem; max-width: 46ch; color: var(--on-carbon-muted); }
  .cta__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 2.5rem; }
  .cta .link { color: var(--on-carbon); }

  .next { padding-block: clamp(4rem, 3rem + 4vw, 8rem); }
  .next__link { display: grid; gap: 0.5rem; text-decoration: none; }
  .next__name { display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-size: var(--t-display); font-weight: 300; letter-spacing: -0.05em; line-height: 1; }
  .next__name :global(svg) { flex: none; transition: transform 0.4s var(--ease-out); }
  .next__link:hover .next__name :global(svg) { transform: translateX(8px); }
</style>
