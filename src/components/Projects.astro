---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { anchors, routes, t } from '@/i18n/ui';
import { projects, statusLabel, type Lang } from '@/data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const i = t(lang);
---
<section class="section work" id={anchors[lang].work} aria-labelledby="work-title">
  <header class="wrap work__head">
    <div class="work__text">
      <h2 id="work-title" class="heading" data-reveal>{i.work.title}</h2>
      <p class="work__intro" data-reveal>{i.work.intro}</p>
    </div>
    <figure class="reel" data-reveal>
      <video muted loop playsinline preload="none" poster="/media/reel-poster.jpg" width="960" height="600" data-reel-video aria-label={i.work.reel}>
        <source src="/media/reel.webm" type="video/webm" />
        <source src="/media/reel.mp4" type="video/mp4" />
      </video>
      <figcaption class="small soft">
        {i.work.reelCaption}
        <button type="button" class="toggle" data-reel-toggle data-pause={i.work.pause} data-play={i.work.play} hidden>{i.work.pause}</button>
      </figcaption>
    </figure>
  </header>

  <ol role="list" class="projects">
    {projects.map((p) => {
      const href = routes.project[lang](p.slug);
      return (
        <li class="project">
          <article aria-labelledby={`p-${p.slug}`}>
            <div class="strip-wrap">
            <div class="strip" tabindex="0" role="region" aria-label={`${i.work.frames} ${p.name}`} data-strip>
              {p.frames.map((src, n) => (
                <a class="strip__frame" href={href} tabindex="-1" aria-hidden={n === 0 ? undefined : 'true'} data-vt={n === 0 ? `shot-${p.slug}` : undefined} data-track="project_open" data-track-where="strip" data-project={p.slug}>
                  <Picture
                    src={src}
                    alt={n === 0 ? p.cover.desktop.alt[lang] : ''}
                    formats={['avif']}
                    fallbackFormat="webp"
                    widths={[720, 1080, 1440]}
                    sizes="(min-width: 48rem) 73vw, 78vw"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ))}
            </div>
            <div class="strip-nav" data-strip-nav hidden>
              <button type="button" class="sq" data-strip-prev aria-label={`${i.work.prev}: ${p.name}`}><Icon name="ArrowLeft" /></button>
              <button type="button" class="sq" data-strip-next aria-label={`${i.work.next}: ${p.name}`}><Icon name="ArrowRight" /></button>
            </div>
            </div>

            <div class="wrap facts" data-reveal>
              <div class="facts__name">
                <h3 id={`p-${p.slug}`}><a href={href} data-track="project_open" data-track-where="list" data-project={p.slug}>{p.name}</a></h3>
                <p class="soft">{p.sector[lang]}</p>
                <p class="facts__links">
                  <a class="link" href={href} data-track="project_open" data-track-where="list_link" data-project={p.slug}>{i.work.caseLink}<Icon name="ArrowRight" /></a>
                  {p.online
                    ? <a class="link" href={p.url} target="_blank" rel="noopener" data-track="project_visit" data-project={p.slug}>{p.urlLabel}<Icon name="ArrowUpRight" /></a>
                    : <span class="soft">{i.work.offline}</span>}
                </p>
              </div>
              <p class="facts__cell"><span class="sr-only">{i.work.status}: </span><span class={`status status--${p.status}`}>{statusLabel[p.status][lang]}</span><span class="soft facts__note">{p.statusNote[lang].split(' · ').slice(1).join(' · ')}</span></p>
              <p class="facts__cell"><span class="sr-only">{i.work.year}: </span>{p.year}</p>
              <p class="facts__cell"><span class="sr-only">{p.sold ? i.work.client : i.work.forWhom}: </span>{p.client[lang]}</p>
            </div>
          </article>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .work__head { display: grid; gap: 3rem; margin-bottom: 5rem; }
  .work__text { display: grid; gap: 1.25rem; align-content: start; }
  @media (min-width: 64rem) { .work__head { grid-template-columns: repeat(12, 1fr); column-gap: 1.25rem; } .work__text { grid-column: 1 / 6; } .reel { grid-column: 6 / 13; } }
  .reel video { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; background: var(--surface-2); }
  .reel figcaption { margin-top: 0.6rem; }
  .work__intro { max-width: 46ch; font-size: var(--t-lead); font-weight: 300; line-height: 1.3; }

  .projects { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(4rem, 2rem + 8vw, 15rem); }
  .project, .project article { min-width: 0; }

  .strip-wrap { position: relative; }
  .strip-nav { position: absolute; right: var(--margin); bottom: 1rem; display: flex; gap: 0.5rem; }
  @media (hover: none) { .strip-nav { display: none; } }
  /* One slide, two neighbours: the centre frame is 73% wide, the previous/next peek in at the edges. */
  .strip {
    display: flex; gap: 20px;
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    padding-inline: 13.5vw;
    scroll-padding-inline: 13.5vw;
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar { display: none; }
  .strip:focus-visible { outline-offset: -3px; }
  .strip__frame { flex: none; width: 73vw; aspect-ratio: 16 / 9.2; scroll-snap-align: center; background: var(--surface-2); }
  .strip__frame { display: block; }
  .strip__frame :global(picture) { display: block; height: 100%; }
  .strip__frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 1.2s var(--ease-out); }
  .strip__frame { overflow: hidden; }
  .strip__frame:hover :global(img) { transform: scale(1.025); }

  .facts { display: grid; gap: 0.75rem 1.25rem; margin-top: 1.6rem; grid-template-columns: 1fr 1fr; }
  .facts__name { grid-column: 1 / -1; }
  .facts h3 { font-size: var(--t-lead); font-weight: 400; letter-spacing: -0.015em; line-height: 1.2; }
  .facts h3 a { text-decoration: none; }
  .facts h3 a:hover { text-decoration: underline; }
  .facts__links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: 0.75rem; }
  .facts__cell { display: grid; align-content: start; gap: 0.2rem; }
  .facts__note { font-size: var(--t-small); }
  @media (min-width: 64rem) {
    .facts { grid-template-columns: repeat(12, 1fr); }
    .facts__name { grid-column: 1 / 4; }
    .facts__cell:nth-child(2) { grid-column: 4 / 7; }
    .facts__cell:nth-child(3) { grid-column: 7 / 10; }
    .facts__cell:nth-child(4) { grid-column: 10 / 13; }
  }
  @media (max-width: 47.99rem) {
    .strip { gap: 10px; padding-inline: 11vw; scroll-padding-inline: 11vw; }
    .strip__frame { width: 78vw; aspect-ratio: 4 / 5; }
  }
</style>
