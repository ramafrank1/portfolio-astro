---
// Photo: src/assets/ramiro.png (prepared with scripts/prepare-photo.mjs from a low-resolution original,
// so it is shown small — as a drop cap — and in black and white; colour on hover).
import { Picture } from 'astro:assets';
import photo from '@/assets/ramiro.png';
import { anchors, t } from '@/i18n/ui';
import { about } from '@/data/content';
import { contact } from '@/data/site';
import type { Lang } from '@/data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const i = t(lang);
const [name, ...rest] = about.statement[lang].split('. ');
---
<section class="section about" id={anchors[lang].about} aria-labelledby="about-title">
  <div class="wrap about__grid">
    <aside class="about__side" data-reveal>
      <h2 id="about-title" class="about__title">{i.about.title}</h2>
      <dl class="facts small">
        <div><dt class="soft">{i.about.facts.base}</dt><dd>{about.facts.base[lang]}</dd></div>
        <div><dt class="soft">{i.about.facts.since}</dt><dd>{about.facts.since[lang]}</dd></div>
        <div><dt class="soft">{i.about.facts.reach}</dt><dd><a href={`mailto:${contact.email}`} data-track="contact_email" data-track-where="about">{contact.email}</a></dd></div>
      </dl>
    </aside>

    <div class="about__text">
      <p class="statement" data-reveal>
        <Picture src={photo} alt={lang === 'es' ? 'Foto de Ramiro Frank' : 'Photo of Ramiro Frank'} formats={['avif']} fallbackFormat="webp" widths={[200, 400]} sizes="9rem" loading="lazy" decoding="async" class="portrait" />
        <strong>{name}.</strong> <span class="soft-ink">{rest.join('. ')}</span>
      </p>
      <p class="statement statement--more soft-ink" data-reveal>{about.more[lang]}</p>
      <ul role="list" class="stack small" data-reveal>
        {about.stack.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid { display: grid; gap: 2.5rem; }
  @media (min-width: 64rem) {
    .about__grid { grid-template-columns: repeat(12, 1fr); column-gap: 1.25rem; }
    .about__side { grid-column: 1 / 3; }
    .about__text { grid-column: 3 / 13; }
  }
  .about__title { font-size: var(--t-body); font-weight: 500; letter-spacing: 0; line-height: 1.3; }
  .facts { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .facts dd { margin: 0.15rem 0 0; overflow-wrap: anywhere; }

  .statement { font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem); font-weight: 300; line-height: 1.2; letter-spacing: -0.02em; max-width: 34em; }
  .statement strong { font-weight: 400; }
  .soft-ink { color: #3c3e3d; }
  .statement :global(.portrait) { float: left; width: 3.6em; height: 3.6em; margin: 0.15em 0.5em 0 0; object-fit: cover; filter: grayscale(1) contrast(1.06); transition: filter 0.5s; }
  .statement:hover :global(.portrait) { filter: none; }
  .statement--more { margin-top: 1.2em; font-size: var(--t-lead); line-height: 1.35; max-width: 40em; }

  .stack { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 3rem; }
  .stack li { padding: 0.35rem 0.7rem; background: var(--surface-2); }
  @media (max-width: 47.99rem) {
    .statement :global(.portrait) { width: 4.6em; height: 4.6em; }
  }
</style>
